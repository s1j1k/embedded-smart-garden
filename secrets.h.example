#ifndef SMART_GARDEN_SECRETS_H
#define SMART_GARDEN_SECRETS_H

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored — do not commit it.

// --- WiFi networks (tried by signal when both are visible) ---
// auth: 0 = WPA2-PSK (home), 1 = WPA2-Enterprise PEAP/MSCHAPv2 (UniWireless)
// For UniMelb UniWireless, eapUsername is usually:
//   students:  YOUR_USERNAME@student.unimelb.edu.au
//   staff:     YOUR_USERNAME@unimelb.edu.au
// eapIdentity is the outer/anonymous identity — leave "" for UniWireless.
struct WifiNetworkProfile {
  const char* ssid;
  uint8_t auth;  // 0 = PSK, 1 = WPA2-Enterprise PEAP
  const char* password;
  const char* eapIdentity;   // outer/anonymous; unused for PSK
  const char* eapUsername;   // inner identity; unused for PSK
  // MQTT broker on this network; omit (nullptr) to use MQTT_BROKER_HOST.
  // A *.local name is found by mDNS, so the Pi's DHCP address can change.
  const char* mqttBrokerHost;
};

static const WifiNetworkProfile WIFI_NETWORKS[] = {
  {
    "HOME_WIFI",
    0,
    "YOUR_WIFI_PASSWORD",
    "",
    "",
  },
  {
    "UniWireless",
    1,
    "YOUR_UNIMELB_PASSWORD",
    "",  // anonymous outer identity; empty sends the username (as the Pi does)
    "YOUR_USERNAME@student.unimelb.edu.au",
    "smar-gardon.local",  // Pi hostname; campus DHCP address varies
  },
};

static const size_t WIFI_NETWORK_COUNT =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// Back-compat for sketches that still expect a single PSK network.
// static: each .cpp gets its own copy (arduino-cli compiles modules separately).
static const char* WIFI_SSID = WIFI_NETWORKS[0].ssid;
static const char* WIFI_PASSWORD = WIFI_NETWORKS[0].password;

// --- MQTT broker (set ENABLE_MQTT 1 in embedded-smart-garden.ino) ---
// Local PC dashboard (ChromeOS / laptop on HOME_WIFI):
//   1. Run ~/dev/smart-garden-iot-dashboard/scripts/run-local-dashboard.sh
//   2. Set MQTT_BROKER_HOST to this PC's *WiFi* LAN IP (Settings → Network),
//      NOT the Linux container IP (100.115.x.x). On ChromeOS also port-forward
//      TCP 1883 into Linux.
// Raspberry Pi hub (later):
//   MQTT_BROKER_HOST = "smart-garden.local";  // or Pi LAN IP from hostname -I
// Note: MQTT to a home Chromebook will not work from UniWireless; Influx Cloud will.
static const char* MQTT_BROKER_HOST = "192.168.4.163";  // this PC WiFi IP on HOME_WIFI
static const char* MQTT_USERNAME = "";
static const char* MQTT_PASSWORD = "";

// --- InfluxDB Cloud (set ENABLE_INFLUXDB 1 in embedded-smart-garden.ino) ---
// InfluxDB UI → Load Data → API Tokens → Generate (read/write on your bucket).
// Copy the cluster URL from the same page (no trailing slash).
// inline: one shared definition across .cpp TUs (InfluxCloud header uses these).
inline const char* const INFLUX_URL = "https://us-east-1-1.aws.cloud2.influxdata.com";
inline const char* const INFLUX_ORG = "YOUR_ORG_NAME_OR_ID";
inline const char* const INFLUX_BUCKET = "smart-garden";
inline const char* const INFLUX_TOKEN = "YOUR_INFLUX_API_TOKEN";
inline const char* const INFLUX_DEVICE_ID = "garden-node-01";

#endif  // SMART_GARDEN_SECRETS_H
